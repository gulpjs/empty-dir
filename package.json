  "description": "Check if a directory is empty.",
  "author": "Gulp Team <team@gulpjs.com> (https://gulpjs.com/)",
  "contributors": [
    "Tyler Kellen <tyler@sleekcode.net>",
    "Jon Schlinkert <jon.schlinkert@sellside.com>",
